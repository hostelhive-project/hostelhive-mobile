# HostelHive Mobile Environment Configuration Template
# EXPO_PUBLIC_* variables are bundled into client build and are publicly accessible.
# Do NOT store any private keys, backend secrets, or database URLs here.

# Local development:
# - Android Emulator: http://10.0.2.2:5000/api
# - Physical Android device over Wi-Fi: use your computer's LAN IP, e.g. http://192.168.1.10:5000/api
# - iOS Simulator / Web: http://localhost:5000/api
# Production deployment:
# - Production API: https://api.yourdomain.com/api
EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api
